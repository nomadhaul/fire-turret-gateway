    <script>
        function call(endpoint) {
            fetch(endpoint, {method: 'POST'}).catch(err => console.error("Request failed", err));
        }

        function setMode(mode) {
            fetch(`/api/mode/${mode}`, {method: 'POST'}).then(() => {
                document.getElementById('btn-manual').classList.toggle('active', mode === 'manual');
                document.getElementById('btn-auto').classList.toggle('active', mode === 'auto');
            });
        }

        function toggleSensor(zone) {
            fetch(`/api/sensor/${zone}/toggle`, {method: 'POST'})
                .then(res => res.json())
                .then(data => {
                    const btn = document.getElementById(`s-${zone}`);
                    if(data.state) {
                        btn.classList.remove('off');
                    } else {
                        btn.classList.add('off');
                    }
                });
        }
    </script>
