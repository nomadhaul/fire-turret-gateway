        <div class="dashboard">
            <div class="panel">
                <h3>Manual Aim</h3>
                <div class="d-pad">
                    <button style="grid-area: lu" class="btn-diag" onclick="call('/api/camera/move?pan=4.0&tilt=9.0')">↖</button>
                    <button style="grid-area: up" class="btn-cam" onclick="call('/api/camera/move?pan=keep&tilt=9.0')">UP</button>
                    <button style="grid-area: ru" class="btn-diag" onclick="call('/api/camera/move?pan=11.0&tilt=9.0')">↗</button>

                    <button style="grid-area: left" class="btn-cam" onclick="call('/api/camera/move?pan=4.0&tilt=keep')">LEFT</button>
                    <button style="grid-area: center" class="btn-cam" onclick="call('/api/camera/move?pan=7.5&tilt=7.5')">CENTER</button>
                    <button style="grid-area: right" class="btn-cam" onclick="call('/api/camera/move?pan=11.0&tilt=keep')">RIGHT</button>

                    <button style="grid-area: ld" class="btn-diag" onclick="call('/api/camera/move?pan=4.0&tilt=6.0')">↙</button>
                    <button style="grid-area: down" class="btn-cam" onclick="call('/api/camera/move?pan=keep&tilt=6.0')">DOWN</button>
                    <button style="grid-area: rd" class="btn-diag" onclick="call('/api/camera/move?pan=11.0&tilt=6.0')">↘</button>
                </div>
