            <div class="panel">
                <h3>Mitigation Controls</h3>
                <button class="btn-danger" onclick="call('/api/pump/on')">WATER ON</button>
                <button class="btn-action" onclick="call('/api/pump/off')">WATER OFF</button>
                
                <h3 style="margin-top: 20px;">Sensor Logic</h3>
                <button id="s-LEFT" class="btn-toggle" onclick="toggleSensor('LEFT')">LEFT IR</button>
                <button id="s-CENTER" class="btn-toggle" onclick="toggleSensor('CENTER')">CENTER IR</button>
                <button id="s-RIGHT" class="btn-toggle" onclick="toggleSensor('RIGHT')">RIGHT IR</button>
